# Copy to .env.local (gitignored). Local SQLite path by default.
# Default when unset: file:./data/tic-tac-toe.db
DATABASE_URL=file:./data/tic-tac-toe.db

# Required ONLY when DATABASE_URL is an http(s):// or libsql:// Turso URL.
# Leave unset for the file: branch used in local dev and CI.
# DATABASE_AUTH_TOKEN=<turso-issued-token>

# 本文件是 .env.local 的模板，会随 git 提交（不含任何 secret）。
# 本地开发**不需要**复制 .env.local — lib/db.ts 在 DATABASE_URL 未设时
# fallback 到 file:./data/tic-tac-toe.db（@libsql/client 自带嵌入式 sqlite）。
# 只有当你需要 (a) 自定义本地 db 路径 或 (b) 联调 Turso HTTP 远程库时，
# 才复制本文件为 .env.local 并填值。
DATABASE_URL=file:./data/tic-tac-toe.db

# Required ONLY when DATABASE_URL is an http(s):// or libsql:// Turso URL.
# Leave unset for the file: branch used in local dev and CI.
# DATABASE_AUTH_TOKEN=<turso-issued-token>
